# The deployed site ALWAYS reads the REAL (public CI) dataset, fetched at runtime
# from raw.githubusercontent.com so new benchmark results appear without a redeploy
# (design/frontend.md, design/data.md). This is the production source of truth;
# the built-in fallback in src/lib/data/urls.ts mirrors it.
NEXT_PUBLIC_DATA_BASE_URL=https://raw.githubusercontent.com/ReactiveBayes/RxInferBenchmarks.jl/main/data
