# Local dev (`next dev`) reads the FAKE seed dataset, so the UI is populated
# without needing the public CI results. `predev` symlinks public/local-data -> ../../data,
# so /local-data/seed resolves to the repo's data/seed/ tree (design/frontend.md, design/data.md).
#
# To preview the REAL (public CI) dataset locally instead, override per-run:
#   NEXT_PUBLIC_DATA_BASE_URL=/local-data/results-root npm run dev   # not set up by default
# or point at production raw data:
#   NEXT_PUBLIC_DATA_BASE_URL=https://raw.githubusercontent.com/ReactiveBayes/RxInferBenchmarks.jl/main/data npm run dev
NEXT_PUBLIC_DATA_BASE_URL=/local-data/seed
